# Copia este ficheiro para ".env" e preenche os valores.
# NUNCA metas o ficheiro ".env" real no Git (já está no .gitignore).

# Chave secreta do Flask (podes gerar uma com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Base de dados (SQLite local por defeito - nao precisas de mudar para testar)
DATABASE_URL=sqlite:///himdub.db

# Stripe (loja / bilhetes) - deixa em branco para correr em "modo demo"
# (o checkout funciona na mesma, mas simula o pagamento em vez de cobrar a serio)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Segredo do webhook do Stripe (confirma pagamentos de forma fiavel, mesmo
# que o cliente feche a pagina antes de voltar ao site). Para testar local:
#   1. Instala a Stripe CLI: https://stripe.com/docs/stripe-cli
#   2. Corre: stripe login
#   3. Corre: stripe listen --forward-to localhost:5000/webhooks/stripe
#   4. Copia o "whsec_..." que aparece para aqui
# Em producao, cria o webhook no Dashboard do Stripe apontado para
# https://teudominio.com/webhooks/stripe e copia o segredo de la.
STRIPE_WEBHOOK_SECRET=

# Dominio usado para construir os links de sucesso/cancelamento do Stripe
DOMAIN=http://127.0.0.1:5000

# Password para entrares em /admin/orders e veres as encomendas/bilhetes
# vendidos, exportar Excel e emitir bilhetes de cortesia. Deixa em branco
# para desligar essa pagina.
ADMIN_PASSWORD=

# Segunda password, so para a equipa do check-in a entrada do festival --
# entra so no scanner de bilhetes (/checkin), sem ver receita, encomendas
# nem poder emitir bilhetes de cortesia. Deixa em branco para desligar (so
# a ADMIN_PASSWORD funciona, como antes).
CHECKIN_PASSWORD=

# Bloqueio do site INTEIRO por password (dialogo do browser), usado antes
# do lancamento oficial para ninguem cair aqui por engano. Deixa
# SITE_LOCK_PASSWORD em branco para desligar; não há palavra-passe predefinida.
SITE_LOCK_USERNAME=himdub
SITE_LOCK_PASSWORD=

# Envio do email com os bilhetes/QR code, via Resend (https://resend.com).
# Cria conta, verifica o teu dominio em "Domains", e gera uma API key em
# "API Keys". Deixa em branco para correr em modo demo (bilhetes gerados
# na mesma, so sem email a serio -- ve-los em /admin/orders).
RESEND_API_KEY=
# Tem de ser um endereco @ do dominio que verificaste no Resend.
RESEND_FROM_EMAIL=bilhetes@himdubfestival.com

# Vídeos e áudio: URL público da zona CDN Bunny (não é uma chave de API).
CDN_BASE_URL=

# Estado inicial para desenvolvimento local. Em produção, confirmar antes de alterar.
COMING_SOON_MODE=off

# Em produção, APP_ENV=production; o Render também é detetado automaticamente.
APP_ENV=development
# As contas individuais substituem as passwords partilhadas em produção.
# Criar contas com: flask --app app user-add email --role admin
# O worker consome a fila persistente apenas em produção por defeito.
EMAIL_WORKER_ENABLED=true

# Imagens do CMS: credenciais de escrita apenas para a zona de armazenamento.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Marketing: segmento da newsletter, apenas contactos com confirmação.
RESEND_NEWSLETTER_SEGMENT_ID=
RESEND_MARKETING_API_KEY=

# Teya Hosted Checkout. Credentials stay on the server; Stripe stays default.
TEYA_ENVIRONMENT=production
TEYA_CLIENT_ID=
TEYA_CLIENT_SECRET=
TEYA_STORE_ID=
TEYA_WEBHOOK_PUBLIC_KEY=
# Enable the selector only after API/webhook validation. Does not select Teya.
TEYA_CHECKOUT_READY=false
